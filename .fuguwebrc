# The website, built by fuguweb(1).

site = FuguBSD

nav "index.html" {
	label = Home
}

page "index.html" {
	title = Home
	body  = index.body.html
}

page "404.html" {
	title    = Not found
	body     = 404.body.html
	unlinked = yes
}

# The published keys of the organization. The rotation
# writes this directory.
keys "keys" {
	org = fugubsd
	url = https://www.fugubsd.org/keys
}

key "fugubsd-1-release" {
	status = current
	since  = 2026-09-08
}
