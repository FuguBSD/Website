# The website, built by fuguweb(1).

site = FuguBSD

nav "index.html" {
	label = Home
}

page "index.html" {
	title = Home
	body  = index.body.html
}

page "404.html" {
	title    = Not found
	body     = 404.body.html
	unlinked = yes
}

# The published keys of fugureleng. The rotation
# writes this directory.
keys "releng" {
	org = fugureleng
	url = https://www.fugubsd.org/releng
}

key "fugureleng-1-root" {
	status = current
	since  = 2026-09-15
}

key "fugureleng-1-release" {
	status = current
	since  = 2026-09-15
}

# The published keys of fuguadmin. The rotation
# writes this directory.
keys "admin" {
	org = fuguadmin
	url = https://www.fugubsd.org/admin
}

key "fuguadmin-1-root" {
	status = current
	since  = 2026-09-15
}
