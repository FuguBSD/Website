# rotate-key - the local half of a release key rotation.
#
# The rotation workflow runs this script. The script reads the key
# directory of the site, makes the change of one step, and writes the
# result into the checkout. It stores no secret and it reaches no
# network: the workflow holds the token and the organization secrets.
#
# Two steps make one rotation. A mint generates the next key of a
# purpose, and the current key signs the manifest that names it. A
# promote makes that key current and retires the old one. The first
# mint of a purpose finds no current key, so it makes the new key
# current at once and the key signs its own manifest.
#
# The script prints one 'name=value' line for each fact that the
# workflow needs, so a caller appends the output to GITHUB_OUTPUT.

use v5.36;
use Digest::SHA ();
use File::Path  qw(make_path);
use File::Temp  qw(tempdir);
use Fugu::Config;
use Fugu::KeyDir;
use Fugu::Signify;
use Getopt::Long qw(GetOptions);
use POSIX        ();

# The two files of the manifest pair, which name no key.
use constant {
	MANIFEST  => 'SHA256',
	SIGNATURE => 'SHA256.sig',
};

my $USAGE = "usage: rotate-key --step <mint|promote> --purpose <word>\n"
    . "                  --secret <path> [--signer <path>] [--root <dir>]\n"
    . "                  [--org <word>] [--dir <name>]\n";

my ( $step, $purpose, $secret, $signer, $root, $org, $dir );
GetOptions(
	'step=s'    => \$step,
	'purpose=s' => \$purpose,
	'secret=s'  => \$secret,
	'signer=s'  => \$signer,
	'root=s'    => \$root,
	'org=s'     => \$org,
	'dir=s'     => \$dir,
) or die $USAGE;

die $USAGE unless defined $step && defined $purpose && defined $secret;
die "rotate-key: the step is mint or promote: $step\n"
    unless $step eq 'mint' || $step eq 'promote';

$root //= '.';

_bootstrap( $root, $org, $dir ) if defined $org;

my $site = _read_site($root);
my $keys = _read_keys($site);

my %result =
    $step eq 'mint'
    ? _mint( $site, $keys, $purpose, $secret )
    : _promote( $site, $keys, $purpose );

_write_manifest( $site, $signer // $secret );

say "$_=$result{$_}" for sort keys %result;

exit 0;

# _bootstrap($root, $org, $dir):
#	Write the keys block of a description that holds none, and
#	make the key directory.
#
#	The first key of a site arrives with the block that describes
#	it. A block that landed first would name a directory with no
#	key and no manifest, and every build would then fail until the
#	key arrived. One commit therefore carries both.
#
#	A description that already holds a keys block keeps it, so a
#	second run changes nothing.
sub _bootstrap ( $root, $org, $dir )
{
	$dir //= 'keys';

	my $path = "$root/.fuguwebrc";
	my $file = Fugu::Config->new( file => $path );
	$file->load or die 'rotate-key: ' . $file->error . "\n";

	my $source = $file->get( 'source_dir', 'web' );
	make_path("$root/$source/$dir") unless -d "$root/$source/$dir";
	die "rotate-key: cannot make $root/$source/$dir\n"
	    unless -d "$root/$source/$dir";

	return 1 if $file->blocks('keys');

	my $text = _slurp($path);
	$text =~ s/\n*\z/\n/;
	$text .= "\n# The published keys of the organization. The rotation\n"
	    . "# workflow of this repository writes the directory.\n"
	    . "keys \"$dir\" {\n"
	    . "\torg = $org\n"
	    . "\turl = https://www.fugubsd.org/$dir\n"
	    . "}\n";

	return _spew( $path, $text );
}

# _read_site($root):
#	The parts of the site that this script writes: the project
#	root, the description path, the key directory, and the key
#	names of the organization.
sub _read_site ($root)
{
	my $path = "$root/.fuguwebrc";
	my $file = Fugu::Config->new( file => $path );
	$file->load or die 'rotate-key: ' . $file->error . "\n";

	my ($block) = $file->blocks('keys');
	die "rotate-key: $path holds no keys block\n" unless $block;

	my $org = $block->{settings}{org};
	die "rotate-key: $path: the keys block has no org\n"
	    unless defined $org && length $org;

	my $source = $file->get( 'source_dir', 'web' );
	my $dir    = "$root/$source/$block->{name}";
	die "rotate-key: $dir is not a directory\n" unless -d $dir;

	return {
		root   => $root,
		path   => $path,
		dir    => $dir,
		keydir => Fugu::KeyDir->new( org => $org ),
	};
}

# _read_keys($site):
#	Every key of the directory, as a hash of file name to the
#	parts of that name. The manifest pair names no key, so the
#	scan skips it.
sub _read_keys ($site)
{
	opendir my $dh, $site->{dir}
	    or die "rotate-key: cannot read $site->{dir}: $!\n";
	my @names = sort grep { !/\A\./ } readdir $dh;
	closedir $dh;

	my %key;
	for my $name (@names) {
		next if $name eq MANIFEST || $name eq SIGNATURE;
		next unless -f "$site->{dir}/$name";

		my $parts = $site->{keydir}->parse_name($name)
		    or die 'rotate-key: ' . $site->{keydir}->error . "\n";
		$key{$name} = $parts;
	}

	return \%key;
}

# _mint($site, $keys, $purpose, $secret):
#	Generate the next key of the purpose, and write its public
#	half into the key directory. The key takes the status current
#	when the purpose holds none, and the status next otherwise.
#
#	The private half goes to the path that the caller named. The
#	workflow writes that path into an organization secret and then
#	removes it.
sub _mint ( $site, $keys, $purpose, $secret )
{
	my $serial = $site->{keydir}->next_serial( [ keys %$keys ], $purpose )
	    or die 'rotate-key: ' . $site->{keydir}->error . "\n";

	my $name = $site->{keydir}->name_for(
		serial  => $serial,
		purpose => $purpose,
		type    => 'signify'
	) or die 'rotate-key: ' . $site->{keydir}->error . "\n";

	my $stem = $name =~ s/\.pub\z//r;
	die "rotate-key: $name exists already\n" if -e "$site->{dir}/$name";

	# signify(1) holds the pair to one stem: <name>.pub beside
	# <name>.sec. The pair is therefore made in a temporary
	# directory, and each half then goes where it belongs. The
	# directory dies with the process, so no secret stays behind.
	#
	# signify(1) also writes ' public key' after the comment that
	# the caller names, so the published comment is '<stem> public
	# key'. That is the form that the key directory states.
	my $work = tempdir( CLEANUP => 1 );
	_run( 'signify', '-G', '-n', '-c', $stem,
		'-p', "$work/$stem.pub", '-s', "$work/$stem.sec" );

	_spew( "$site->{dir}/$name", _slurp("$work/$stem.pub") );
	_spew( $secret,              _slurp("$work/$stem.sec") );
	chmod 0600, $secret;

	my $status = _current( $keys, $purpose ) ? 'next' : 'current';
	_add_block( $site, $stem, $status );

	return ( name => $name, stem => $stem, serial => $serial,
		status => $status );
}

# _promote($site, $keys, $purpose):
#	Make the next key of the purpose current, and retire the key
#	that was current. The workflow flips the organization variable
#	that names the active secret slot in the same run.
sub _promote ( $site, $keys, $purpose )
{
	my $status = _statuses($site);

	my ($next) = grep { $keys->{$_}{purpose} eq $purpose }
	    grep { ( $status->{ _stem_of($_) } // '' ) eq 'next' }
	    sort keys %$keys;
	die "rotate-key: the purpose $purpose holds no next key\n"
	    unless $next;

	my $old = _current( $keys, $purpose, $status );

	my $today = POSIX::strftime( '%Y-%m-%d', gmtime );
	_set_status( $site, _stem_of($next), 'current' );
	_set_status( $site, _stem_of($old), 'retired', $today ) if $old;

	return (
		name => $next,
		stem => _stem_of($next),
		serial => $keys->{$next}{serial},
		status => 'current',
		retired => $old // '',
	);
}

# _write_manifest($site, $secret):
#	Rewrite the manifest over every key file, and sign it with the
#	key that the caller named. The manifest is a source file,
#	because the site build cannot sign.
sub _write_manifest ( $site, $secret )
{
	my $keys = _read_keys($site);

	my %digest;
	for my $name ( sort keys %$keys ) {
		$digest{$name} = _digest("$site->{dir}/$name");
	}

	my $signify = Fugu::Signify->new(
		keys => [ map { "$site->{dir}/$_" } sort keys %$keys ] );

	my $text = $signify->write_manifest( \%digest )
	    or die 'rotate-key: ' . $signify->error . "\n";

	_spew( "$site->{dir}/" . MANIFEST, $text );

	unlink "$site->{dir}/" . SIGNATURE;
	_run( 'signify', '-S', '-s', $secret,
		'-m', "$site->{dir}/" . MANIFEST,
		'-x', "$site->{dir}/" . SIGNATURE );

	return 1;
}

# _statuses($site):
#	The status of each key block of the description, by stem.
sub _statuses ($site)
{
	my $file = Fugu::Config->new( file => $site->{path} );
	$file->load or die 'rotate-key: ' . $file->error . "\n";

	return { map { $_->{name} => $_->{settings}{status} }
		    $file->blocks('key') };
}

# _current($keys, $purpose, $status):
#	The file name of the current key of the purpose, or undef.
sub _current ( $keys, $purpose, $status = undef )
{
	$status //= {};

	for my $name ( sort keys %$keys ) {
		next unless $keys->{$name}{purpose} eq $purpose;
		next unless ( $status->{ _stem_of($name) } // 'current' ) eq
		    'current';
		return $name;
	}

	return;
}

# _add_block($site, $stem, $status):
#	Append one key block to the description. A new block goes at
#	the end, so the file keeps every block that it held and the
#	diff shows the addition alone.
sub _add_block ( $site, $stem, $status )
{
	my $today = POSIX::strftime( '%Y-%m-%d', gmtime );
	my $text  = _slurp( $site->{path} );
	$text =~ s/\n*\z/\n/;

	$text .= "\nkey \"$stem\" {\n\tstatus = $status\n"
	    . "\tsince  = $today\n}\n";

	return _spew( $site->{path}, $text );
}

# _set_status($site, $stem, $status, $until):
#	Rewrite the status of one key block, and add an until date
#	when the caller names one. The scan reads the block that the
#	stem names, and it touches no other line.
sub _set_status ( $site, $stem, $status, $until = undef )
{
	my @lines = split /\n/, _slurp( $site->{path} ), -1;

	my ( $inside, $done ) = ( 0, 0 );
	my @out;
	for my $line (@lines) {
		if ( $line =~ /\A\s*key\s+"\Q$stem\E"\s*\{\s*\z/ ) {
			$inside = 1;
			push @out, $line;
			next;
		}

		if ( $inside && $line =~ /\A\s*\}\s*\z/ ) {
			push @out, "\tuntil  = $until" if defined $until;
			$inside = 0;
			push @out, $line;
			next;
		}

		if ( $inside && $line =~ /\A(\s*status\s*=\s*)\S+\s*\z/ ) {
			push @out, "$1$status";
			$done = 1;
			next;
		}

		push @out, $line;
	}

	die "rotate-key: no key block names $stem\n" unless $done;

	return _spew( $site->{path}, join "\n", @out );
}

# _stem_of($name):
#	The stem of a key file name.
sub _stem_of ($name)
{
	return $name =~ s/\.[^.]+\z//r;
}

# _digest($path):
#	The lowercase hex SHA256 of the file.
sub _digest ($path)
{
	open my $fh, '<', $path or die "rotate-key: cannot read $path: $!\n";
	binmode $fh;

	my $sha = Digest::SHA->new(256);
	$sha->addfile($fh);
	close $fh;

	return lc $sha->hexdigest;
}

# _slurp($path), _spew($path, $bytes):
#	Read and write a whole file, as bytes.
sub _slurp ($path)
{
	open my $fh, '<', $path or die "rotate-key: cannot read $path: $!\n";
	binmode $fh;
	my $bytes = do { local $/; <$fh> };
	close $fh;

	return $bytes;
}

sub _spew ( $path, $bytes )
{
	open my $fh, '>', $path or die "rotate-key: cannot write $path: $!\n";
	binmode $fh;
	print {$fh} $bytes;
	close $fh or die "rotate-key: cannot write $path: $!\n";

	return 1;
}

# _run(@cmd):
#	Run one command, and die when it fails. The first word is a
#	program name, and the script never builds a shell line, so no
#	argument can become part of a command.
sub _run (@cmd)
{
	$cmd[0] = _signify() if $cmd[0] eq 'signify';

	system { $cmd[0] } @cmd;
	return 1 if $? == 0;

	die "rotate-key: $cmd[0] failed with status " . ( $? >> 8 ) . "\n";
}

# _signify():
#	The signify command of this machine. Debian names the OpenBSD
#	program signify-openbsd, because the plain name belongs to an
#	unrelated package there.
sub _signify ()
{
	state $found;
	return $found if defined $found;

	for my $name (qw(signify-openbsd signify)) {
		for my $dir ( split /:/, $ENV{PATH} // '' ) {
			next unless -x "$dir/$name";
			return $found = "$dir/$name";
		}
	}

	die "rotate-key: no signify command on the path\n";
}
